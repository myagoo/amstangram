{
  "label": "amstangram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "homepage": "https://www.amstangr.am/",
  "scripts": {
    "prepare": "bun run --bun panda codegen",
    "dev": "bun run --bun vite",
    "build": "bun run typecheck && bun run --bun vite build",
    "typecheck": "bun run --bun tsc --noEmit",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "bun run --bun vitest run",
    "test:e2e": "bun run --bun playwright test",
    "lint": "bun run --bun eslint src --ext ts,tsx --report-unused-disable-directives",
    "preview": "bun run --bun vite preview",
    "deploy": "bun run build && bun run --bun gh-pages -d dist"
  },
  "dependencies": {
    "@sentry/browser": "7.83.0",
    "firebase": "10.7.0",
    "offset-polygon": "^0.9.2",
    "paper": "0.12.17",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-icons": "5.7.0",
    "react-intl": "12.1.2",
    "use-sound": "5.0.0"
  },
  "devDependencies": {
    "@pandacss/dev": "1.12.1",
    "@playwright/test": "1.63.0",
    "@types/howler": "2.2.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.18.0",
    "@typescript-eslint/parser": "8.18.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "8.57.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "gh-pages": "6.1.0",
    "typescript": "5.7.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
